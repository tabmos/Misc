#!name=Apple Mail BIMI (精简版)
#!desc=仅代理 Apple Mail 隐私保护中继与地区判定域名，解决 BIMI/品牌图标显示问题，不影响 iCloud 同步流量与国内地图。
#!author=tabmos
#!system=ios,macos
#!arguments=Policy:PROXY
#!arguments-desc=Policy: 填写你的海外代理策略组名称（如 Proxy、US 等，区分大小写）
#!category=tabmos

[Rule]
# 1. 邮件隐私保护与中继代理（拉取 BIMI SVG 与远程图片）
DOMAIN,mask.icloud.com,{{{Policy}}}
DOMAIN,mask-h2.icloud.com,{{{Policy}}}
DOMAIN,mask-api.icloud.com,{{{Policy}}}
DOMAIN,mask.apple-dns.net,{{{Policy}}}

# 2. 地区判定与品牌图标 CDN
DOMAIN,gspe1-ssl.ls.apple.com,{{{Policy}}}
DOMAIN-SUFFIX,cdn.apple-mapkit.com,{{{Policy}}}

# 可选：如所用节点不支持 UDP 转发，取消下行注释以屏蔽 QUIC 并强制回退至 TCP
AND,((DOMAIN,mask.icloud.com), (PROTOCOL,UDP)),REJECT-NO-DROP
